{
  "name": "methodmesh-desktop",
  "version": "0.1.0",
  "description": "A modular desktop evidence-tool framework for MethodMesh.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main/main.js && node --check src/main/runtime.js && node --check src/main/adapters.js && node --check src/main/preload.js && node --check src/renderer/app.js && node --check src/renderer/modules.js && node --check modules/*/renderer.js",
    "test": "node test/runtime.test.js && node test/artifacts.test.js",
    "package:mac": "electron-builder --mac dmg zip",
    "package:win": "electron-builder --win nsis",
    "package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "asn1js": "^3.0.6",
    "jszip": "^3.10.1",
    "pkijs": "^3.2.5"
  },
  "build": {
    "appId": "org.methodmesh.desktop",
    "productName": "MethodMesh Desktop",
    "asar": true,
    "icon": "assets/methodmesh-icon-1024.png",
    "files": ["src/**", "modules/**", "assets/**", "package.json"],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.18.0"
  }
}
